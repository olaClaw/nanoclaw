# Illustrative values only. Copy to .env outside version control and replace.
# This preview profile is not a complete deployable stack.
NANOCLAW_HOST_IMAGE=example.invalid/nanoclaw-host:REPLACE_WITH_COMMIT
NANOCLAW_AGENT_IMAGE=example.invalid/nanoclaw-agent:REPLACE_WITH_SAME_COMMIT
NANOCLAW_BROKER_IMAGE=example.invalid/nanoclaw-brokers:REPLACE_WITH_SAME_COMMIT
NANOCLAW_INSTALL_ID=olaclaw-preview
DOCKER_SOCKET_GID=999
POSTGRES_IMAGE=docker.io/library/postgres@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
ONECLI_IMAGE=ghcr.io/onecli/onecli@sha256:8c7197388c5fde90533cf7f1b35468d3e7dec4ca41a83f97511cf0f30e535ba0
ONECLI_DB_PASSWORD_FILE=/srv/nanoclaw/secrets/onecli-db-password
SIGNAL_IMAGE=ghcr.io/asamk/signal-cli@sha256:603ab4b5350ce9ab23a8a7771d2d978f20cf0058dfea18e19c753019d162e424
INFOMANIAK_BROKER_CONFIG_FILE=/srv/nanoclaw/secrets/infomaniak-mail.json
INFOMANIAK_DOWNLOAD_DIR=/srv/nanoclaw/groups/example/downloads/infomaniak
NEXTCLOUD_BROKER_CONFIG_FILE=/srv/nanoclaw/secrets/nextcloud-calendar.json

# NanoClaw reads these from the mounted .env file at runtime.
DEFAULT_AGENT_PROVIDER=opencode
OPENCODE_PROVIDER=openai
OPENCODE_BASE_URL=http://LLM_HOST:8000/v1
OPENCODE_MODEL=openai/MODEL_ID
TZ=Europe/Rome

# Supply ONECLI_API_KEY and any channel credentials only in the real .env.
# The Compose preview fixes the OneCLI URL and egress lockdown internally.
