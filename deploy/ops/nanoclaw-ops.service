# Root-side operations service for the NanoClaw dashboard: releases, backups,
# update jobs, and backups started from the panel. Install the scripts from a
# reviewed checkout (see docs/compose-preview.md), then:
#   systemctl daemon-reload && systemctl enable --now nanoclaw-ops
# The paths under /var/lib/nanoclaw-ops are links to this host's checkout,
# backup, key and release-control directories.
[Unit]
Description=NanoClaw dashboard operations service
After=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/nanoclaw/compose-ops.py serve \
  --socket /var/lib/nanoclaw-ops/sock/ops.sock --socket-group 61001 \
  --state-root /srv/nanoclaw \
  --project-root /var/lib/nanoclaw-ops/project \
  --backup-root /var/lib/nanoclaw-ops/backups \
  --key-root /var/lib/nanoclaw-ops/keys \
  --control-backup-root /var/lib/nanoclaw-ops/release-backups \
  --candidates /var/lib/nanoclaw-ops/candidates \
  --jobs-dir /var/lib/nanoclaw-ops/jobs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# Backups write to the backup and key directories and drive Docker, like the
# CLI tool run as root; /usr, /boot and /etc stay read-only.
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
